[Unit]
Description=SN32 humanizer evaluation: mirror the public state (period, queue, results, kings) into W&B

[Service]
Type=oneshot
User=humeval
Group=humeval
UMask=0077
WorkingDirectory=/srv/humeval/humanizer_eval
EnvironmentFile=/etc/humeval/humeval.env
Environment=HUMEVAL_ENV_FILE=/etc/humeval/humeval.env
Environment=WANDB_DIR=/srv/humeval/var/ops/wandb
Environment=WANDB_SILENT=true
ExecStart=/srv/humeval/humanizer_eval/.venv/bin/python scripts/wandb_report.py --api http://127.0.0.1:8032
TimeoutStartSec=180
NoNewPrivileges=true
