[Unit]
Description=SN32 humanizer evaluation: miner API + queue worker
After=network-online.target
Wants=network-online.target

[Service]
User=humeval
Group=humeval
WorkingDirectory=/srv/humeval/humanizer_eval
EnvironmentFile=/etc/humeval/humeval.env
Environment=HUMEVAL_ENV_FILE=/etc/humeval/humeval.env
# network, subnet, mode and address come from the env file (HUMEVAL_*); $HUMEVAL_EXTRA_ARGS is split into words
ExecStart=/srv/humeval/humanizer_eval/.venv/bin/python scripts/intake_server.py \
    --host 127.0.0.1 --port 8032 \
    --metagraph /srv/humeval/var/intake/metagraph.json --lium --state-dir /srv/humeval/var/intake \
    --mode ${HUMEVAL_MODE} --network ${HUMEVAL_NETWORK} --netuid ${HUMEVAL_NETUID} $HUMEVAL_EXTRA_ARGS
Restart=on-failure
RestartSec=10
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/humeval/var
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
