# Copy to /etc/humeval/humeval.env (mode 600, owner humeval). Values stay on this server only.
HUMEVAL_VAR_DIR=/srv/humeval/var
# where the evaluator runs. Test launch: testnet subnet 87, It's AI only, pilot period.
HUMEVAL_MODE=test
HUMEVAL_NETWORK=test
HUMEVAL_NETUID=87
HUMEVAL_PUBLIC_URL=https://SERVER_ADDRESS
HUMEVAL_EXTRA_ARGS=--period pilot-1 --detectors its_ai --allow-missing-human --max-evals-per-day 30
# production: HUMEVAL_MODE=prod HUMEVAL_NETWORK=finney HUMEVAL_NETUID=32
#             HUMEVAL_EXTRA_ARGS=--mirror-repo sergak0/sn32-kings   (period from periods/CURRENT)
# paid detectors (crown)
GPTZERO_API_KEY=
WINSTON_API_KEY=
PANGRAM_API_KEY=
# LLM judges and period generation (OpenRouter only, D-90)
OPENROUTER_API_KEY=
# public copies of king bundles whose own repo is closed (D-70): token that can write to --mirror-repo only
HF_MIRROR_TOKEN=
# Lium pods for the bundles
LIUM_API_KEY=
LIUM_ENABLED=true
LIUM_BALANCE_FLOOR_HOURS=48
# hard spend caps of the local ledger (D-91), USD, over all time: a call past one is refused. In production
# they are off (inf): miners pay for their runs, the soft limit below only alerts
BUDGET_PANGRAM_USD=inf
BUDGET_GPTZERO_USD=inf
BUDGET_WINSTON_USD=inf
BUDGET_OPENROUTER_USD=inf
BUDGET_LIUM_USD=inf
# soft limit (scripts/watchdog.py): since the launch (UTC, ISO 8601) spend should stay under the miners'
# payments + the gap; past it the owner is alerted, nothing stops. REQUIRED in production (the hard caps are
# inf): set it to the launch time, e.g. 2026-11-26T12:00:00
SOFT_LIMIT_SINCE=
SOFT_LIMIT_GAP_USD=300
# and this much more per period begun (building a period: H scoring, the king's run)
SOFT_LIMIT_WEEKLY_USD=300
# payments (TAO in, kept as USDC on Base, billing/tao.py): JSON-RPC endpoints; empty = public defaults
TAO_RPC=
BASE_RPC=
# the notary wallet's SS58 address (the watchdog alerts when its TAO for remark fees runs low)
HUMEVAL_NOTARY_SS58=
# automatic payout (humeval-payout.timer): the treasury's USDC on Base above what miners are owed and the
# reserve goes to this Base address (an exchange deposit address or a crypto card's USDC-on-Base address).
# Empty: off. Send a small test amount first: a service that does not take USDC on Base may lose it
PAYOUT_ADDRESS=
PAYOUT_RESERVE_USDC=50
PAYOUT_MIN_USDC=20
# alerts to the owner (ops/alerts.py, @alarmer_bot): REQUIRED in production, the watchdog and every
# money alert go through it
ALARMER_KEY=

# dynamic spend limit (miners' money + SOFT_LIMIT_GAP_USD over all paid services, enforced); false = hard caps only
SPEND_POOL_LIMIT=true

# W&B: scripts/wandb_report.py mirrors the public state (humeval-wandb.timer); a key of a member of the entity
WANDB_API_KEY=
WANDB_ENTITY=itsai-dev
WANDB_PROJECT=subnet32-humanizer
