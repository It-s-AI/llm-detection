# Copy to .env and fill in. Never commit .env.
# The evaluator also reads ../.env (the owner workspace) if HUMEVAL_ENV_FILE points there.

# --- detectors ---
GPTZERO_API_KEY=
ZEROGPT_API_KEY=
PANGRAM_API_KEY=
# It's AI production detector (proxy for simulations only, never used in crown scoring)
ITS_AI_SPECIAL_URL=
ITS_AI_API_KEY=

# --- LLM gateway (all LLM calls, embeddings) ---
OPENROUTER_API_KEY=

# --- data ---
HF_API_KEY=

# --- execution ---
LIUM_API_KEY=
# Kill switch: set to "true" to allow the runner to rent Lium pods at all.
LIUM_ENABLED=false

# --- hard spending caps (USD) enforced by the local spend ledger ---
BUDGET_PANGRAM_USD=30
BUDGET_GPTZERO_USD=20
BUDGET_ZEROGPT_USD=10
BUDGET_OPENROUTER_USD=25
BUDGET_LIUM_USD=50
# Lium: never let the shared account balance fall below N hours of the other pods' burn rate.
LIUM_BALANCE_FLOOR_HOURS=48

# where ledgers / caches / recordings live (gitignored)
HUMEVAL_VAR_DIR=var
